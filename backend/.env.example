# Copy this file to backend/.env and adjust the values for your machine.
# backend/.env is ignored by git. Never commit real secrets or API keys.

# Comma-separated list of browser origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:3000

# Not used yet. Protected AI endpoints will use it to verify professors'
# Supabase access tokens against the project's public signing keys.
# SUPABASE_URL=https://your-project-ref.supabase.co
