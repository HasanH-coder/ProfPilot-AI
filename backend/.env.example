# Copy this file to backend/.env and fill in the values for your machine.
# backend/.env is ignored by git. Never commit real secrets or API keys.

# Comma-separated list of browser origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:3000

# Supabase: the same two PUBLIC values the frontend uses (frontend/.env.local).
# The API verifies each professor's access token against the project's public
# signing keys and calls Supabase as that professor, so Row Level Security
# applies. No secret or service_role key is needed, or used.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# OpenAI: SECRET. Server-only; never put it in the frontend.
OPENAI_API_KEY=sk-your-key

# Optional overrides (the defaults are shown).
# REASONING_MODEL=gpt-6.1-sol
# REALTIME_MODEL=gpt-realtime-2.1
# REALTIME_VOICE=marin
# REALTIME_TRANSCRIPTION_MODEL=gpt-live-transcribe
# EMBEDDING_MODEL=text-embedding-3-small
# REALTIME_CLIENT_SECRET_SECONDS=120
# PDF_FALLBACK_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
