# Copy this file to frontend/.env.local and fill in the values from your
# Supabase project (dashboard: Connect, or Project Settings > API Keys).
#
# Both values are designed to be public: Row Level Security protects the data.
# Never put a secret key or the service_role key in the frontend.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
